logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
bun-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# ---------------------------------------------------------------- runtime
pids/
*.pid
*.seed
*.pid.lock
.grunt
.lock-wscript

