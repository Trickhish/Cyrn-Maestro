# Copy to .env and fill in. .env is gitignored — never commit it.
#
#   cp .env.example .env
#
# The provider connection Maestro drives the agent loop through.
# CLIProxyAPI speaks the OpenAI chat-completions format.
MAESTRO_PROVIDER_BASE_URL=https://api.ai.dury.dev/v1
MAESTRO_PROVIDER_API_KEY=

# Encrypts provider credentials and node tokens at rest.
# Generate one with:  openssl rand -hex 32
MAESTRO_SECRET_KEY=

# Where the server listens. The reverse proxy is the only thing that should
# reach it, so keep HOST on loopback unless the proxy is on another machine.
PORT=3000
HOST=127.0.0.1

# Public origin, used to build the one-command node install URL.
MAESTRO_PUBLIC_URL=https://maestro.cyrn.fr
